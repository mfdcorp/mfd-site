---
layout: base.njk
title: お知らせ
permalink: /news/
---

<section class="hero">
  <div class="container">
    <h1>お知らせ</h1>
    <p>News</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <ul class="news-list">
      {% for post in collections.news %}
      <li>
        <time>{{ post.date | dateJP }}</time>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </li>
      {% else %}
      <li>お知らせはまだありません。</li>
      {% endfor %}
    </ul>
  </div>
</section>
