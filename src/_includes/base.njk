<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.company_name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.company_name }}">
  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}{{ site.company_name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if site.hero_image %}<meta property="og:image" content="{{ site.url }}{{ site.hero_image }}">{% elif site.logo %}<meta property="og:image" content="{{ site.url }}{{ site.logo }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="alternate" type="application/rss+xml" title="{{ site.company_name }} お知らせ" href="/feed.xml">
  <link rel="stylesheet" href="/assets/css/style.css">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.company_name }}",
    "url": "{{ site.url }}",
    {% if site.logo %}"logo": "{{ site.url }}{{ site.logo }}",{% endif %}
    "email": "{{ site.email }}",
    "address": {
      "@type": "PostalAddress",
      "postalCode": "{{ site.address_zip }}",
      "addressCountry": "JP",
      "streetAddress": "{{ site.address }}"
    },
    "description": "{{ site.description }}"
  }
  </script>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="logo" href="/">
        {% if site.logo %}
          <img src="{{ site.logo }}" alt="{{ site.company_name }}" class="logo-img">
        {% else %}
          MFD
        {% endif %}
      </a>
      <nav class="nav">
        <a href="/">ホーム</a>
        <a href="/company/">会社概要</a>
        <a href="/products/">商品</a>
        <a href="/news/">お知らせ</a>
        <a href="/contact/">お問い合わせ</a>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <p class="footer-company">{{ site.company_name }}</p>
      <p class="footer-address">〒{{ site.address_zip }} {{ site.address }}</p>
      <p class="footer-copyright">&copy; {{ currentYear }} {{ site.company_name }}</p>
    </div>
  </footer>
</body>
</html>
