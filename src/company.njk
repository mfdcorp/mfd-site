---
layout: base.njk
title: 会社概要
permalink: /company/
---

<section class="hero">
  <div class="container">
    <h1>会社概要</h1>
    <p>Company Profile</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <table class="company-table">
      <tr><th>商号</th><td>{{ site.company_name }}（{{ site.company_name_en }}）</td></tr>
      <tr><th>代表者</th><td>{{ site.representative }}</td></tr>
      <tr><th>所在地</th><td>〒{{ site.address_zip }}<br>{{ site.address }}</td></tr>
      <tr><th>設立</th><td>{{ site.founded }}</td></tr>
      <tr><th>資本金</th><td>{{ site.capital }}</td></tr>
      <tr><th>法人番号</th><td>{{ site.corporate_number }}</td></tr>
      <tr><th>事業内容</th><td>{{ site.business_description }}</td></tr>
      <tr><th>連絡先</th><td><a href="mailto:{{ site.email }}">{{ site.email }}</a></td></tr>
    </table>
  </div>
</section>
